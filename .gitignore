# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# クライアントの内部資料（公開リポジトリに置かない）
*.pptx
*.pptx.*

# 上映作品の原本素材・ナビゲーター原本写真（権利者から預かった素材。計4.5GBのため置かない。
# 変換元では assets/film/・assets/nagigater/ だったもの。Web用に縮小したスチールのみ public/assets/ で追跡する）
/public/assets/film/
/public/assets/nagigater/

# 検証の作業ファイル（baseline はコミットするが、実行のたびに作る current は除外）
/verification/current/
/verification/current.fingerprint.json

# Cloudflare Workers のローカルシークレットと作業ディレクトリ
.dev.vars
.dev.vars.*
/.wrangler/
/.open-next/

# 本番DBのバックアップ（本番データのコピーをリポジトリに含めない）
/backups/
